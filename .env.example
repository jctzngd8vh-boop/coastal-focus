# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings → API → service_role key. SERVER-SIDE ONLY — never expose
# this to the browser or commit it. Used only for public order creation and
# the secure order-status lookup (see src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site URL (used in a couple of absolute-link contexts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Resend — owner + customer email notifications (optional but recommended)
# ---------------------------------------------------------------------------
# Without these, the app runs fine — notifications are just skipped and
# logged to notification_logs as "skipped". See docs/NOTIFICATIONS.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Twilio — optional SMS notifications to the owner on new orders
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
